#
# Build rules for projects made up of command-line tools. A port's recipe
# includes rules.mk, then the port's own tools.mk (generated by
# pbxproj-tools.py, which defines TOOLS and each tool's _SRCS, _DIR,
# _FLAGS, _LIBS and _MANS), and then this file. This file builds
# $(OBJ)/bin/<tool> for each tool and installs it in $(ROOT)/<_DIR>.
#
# TOOLS_CFLAGS is added to every compile, and TOOLS_LDFLAGS to every link.
# Sources can be .c, .cc or .cpp (C++, linked with libc++), .y (yacc) or
# .l (lex) files; yacc and lex run on the build machine.

YACC ?= bison -y
LEX  ?= flex
TOOLS_BASE_CFLAGS = $(BASE_CFLAGS) -isystem $(SDK)/usr/local/include \
	-Wno-deprecated-non-prototype $(TOOLS_CFLAGS)

# Disable make's built-in rules: its own yacc and lex rules would write
# their output into the source tree.
.SUFFIXES:

define tool_rules
$(1)_OBJS := $$(patsubst %,$(OBJ)/$(1)/%.o,$$(basename $$($(1)_SRCS)))
$(OBJ)/$(1)/%.o: $(SRCROOT)/%.c
	@mkdir -p $$(dir $$@)
	$(CC) $$(TOOLS_BASE_CFLAGS) $$($(1)_FLAGS) -c $$< -o $$@
$(OBJ)/$(1)/%.o: $(SRCROOT)/%.cc
	@mkdir -p $$(dir $$@)
	$(CXX) $$(TOOLS_BASE_CFLAGS) $$($(1)_FLAGS) -c $$< -o $$@
$(OBJ)/$(1)/%.o: $(SRCROOT)/%.cpp
	@mkdir -p $$(dir $$@)
	$(CXX) $$(TOOLS_BASE_CFLAGS) $$($(1)_FLAGS) -c $$< -o $$@
$(OBJ)/$(1)/%.c: $(SRCROOT)/%.y
	@mkdir -p $$(dir $$@)
	$(YACC) -d -o $$@ $$<
$(OBJ)/$(1)/%.c: $(SRCROOT)/%.l
	@mkdir -p $$(dir $$@)
	$(LEX) -o $$@ $$<
# Generated sources are compiled with two extra include directories: the
# original source's directory, for its headers, and the generated
# directory, for y.tab.h-style headers.
$(OBJ)/$(1)/%.o: $(OBJ)/$(1)/%.c
	$(CC) $$(TOOLS_BASE_CFLAGS) $$($(1)_FLAGS) -I$$(dir $$(patsubst $(OBJ)/$(1)/%,$(SRCROOT)/%,$$<)) \
		-I$$(dir $$<) -c $$< -o $$@
# C++ tools are linked with clang++, against libc++.
$(OBJ)/bin/$(1): $$($(1)_OBJS)
	@mkdir -p $$(dir $$@)
	$$(if $$(filter %.cc %.cpp,$$($(1)_SRCS)),$(CXX),$(CC)) $(BASE_LDFLAGS) $$^ $$($(1)_LIBS) \
		$(TOOLS_LDFLAGS) -o $$@
endef
$(foreach t,$(TOOLS),$(eval $(call tool_rules,$(t))))

TOOL_BINS := $(foreach t,$(TOOLS),$(OBJ)/bin/$(t))

# Install each tool in its directory (with its MODE, if it is setuid or
# setgid). Then create the LINKS (SOURCE:LINK pairs, both relative to the
# root) as hard links. Then install the man pages of the tools and of the
# project (_MANS and MANS, each path:manN with the path relative to the
# project) in /usr/share/man/manN.
install-tools: $(TOOL_BINS)
	set -e; $(foreach t,$(TOOLS),install -d $(ROOT)/$($(t)_DIR); \
		install -m $(or $($(t)_MODE),755) $(OBJ)/bin/$(t) $(ROOT)/$($(t)_DIR)/;)
	set -e; $(foreach l,$(LINKS),install -d $(dir $(ROOT)/$(lastword $(subst :, ,$(l)))); \
		ln -f $(ROOT)/$(firstword $(subst :, ,$(l))) $(ROOT)/$(lastword $(subst :, ,$(l)));)
	set -e; $(foreach m,$(foreach t,$(TOOLS),$($(t)_MANS)) $(MANS),install -d \
		$(ROOT)/usr/share/man/$(lastword $(subst :, ,$(m))); install -m 644 \
		$(SRCROOT)/$(firstword $(subst :, ,$(m))) $(ROOT)/usr/share/man/$(lastword $(subst :, ,$(m)))/;)

# Keep the yacc and lex output after the build, instead of deleting it as
# intermediate files.
.PRECIOUS: $(OBJ)/%.c

.PHONY: install-tools
