# sdk/licenses holds licence texts. mksrccopyright.py copies them into the
# License paragraphs of debian/copyright.
sdk/licenses/
# sdk/copyright holds the copyright files of the toolchain trees, with their
# licence texts. lrc skips copyright files, but not under these names.
sdk/copyright/
# LICENSE.md lists the licences of the other files of OpenLibm.
src/openlibm/LICENSE.md
# licensecheck names the 4-clause NetBSD licence of Libc and Libinfo
# BSD-2-Clause-NetBSD and/or BSD-4-clause.
LicenseRef-BSD-4-Clause-NetBSD-Foundation | BSD-2-Clause-NetBSD and/or BSD-4-clause
LicenseRef-BSD-4-Clause-NetBSD-Foundation-2 | BSD-2-Clause-NetBSD and/or BSD-4-clause
APSL-2.0 AND LicenseRef-BSD-4-Clause-NetBSD-Foundation | APSL-2.0 and/or BSD-2-Clause-NetBSD and/or BSD-4-clause
# Libc/net/FreeBSD/inet_net.3 has the NetBSD licence without its advertising
# clause. licensecheck names it BSD-2-Clause-NetBSD and/or BSD-3-clause.
BSD-3-Clause | BSD-2-Clause-NetBSD and/or BSD-3-clause
# licensecheck names the SMLNJ licence MIT-CMU~warranty.
SMLNJ | MIT-CMU~warranty
# licensecheck names these M.I.T. and University of Delaware notices NTP,
# from their "as is" sentence. They grant use "without fee". The NTP licence
# grants it "with or without fee".
LicenseRef-HPND-MIT | NTP
LicenseRef-HPND-MIT-SIPB | NTP
APSL-2.0-OS-reference AND LicenseRef-HPND-MIT | APSL-2.0 and/or NTP
APSL-2.0-OS-reference AND LicenseRef-HPND-UDel | APSL-2.0 and/or NTP
# licensecheck names the RSA notice of libkern/crypto/md5.h NTP, as lrc does
# for RSA-MD5.
APSL-2.0-OS-reference AND RSA-MD | APSL-2.0 and/or NTP
# licensecheck reads the Sun notice of the CBQ headers as BSD-4-clause and NTP.
APSL-2.0-OS-reference AND LicenseRef-Sun-CBQ | APSL-2.0 and/or BSD-4-clause and/or NTP
# licensecheck names the BSD-4.3RENO notice of net/etherdefs.h NTP, from its
# "as is" sentence.
APSL-2.0-OS-reference AND BSD-4.3RENO | APSL-2.0 and/or NTP
# licensecheck names the removefile licence Expat. It does not match the
# clause on the use of the contributors' names.
LicenseRef-X11-Gauthier | Expat
