 }
 #endif // DARWIN_DIRECTORY_AVAILABLE
 
+#if !DS_AVAILABLE
+static int
+_files_mbr_check_membership_ext(int userid_type, const void *userid, size_t userid_size, int groupid_type, const void *groupid, int *isMember)
+{
+	long bufsize = sysconf(_SC_GETPW_R_SIZE_MAX);
+	long grbufsize = sysconf(_SC_GETGR_R_SIZE_MAX);
+	struct passwd pwd, *pwdp = NULL;
+	struct group grp, *grpp = NULL;
+	char name[MAXLOGNAME + 1];
+	id_t id;
+	int type;
+	gid_t pgid;
+
+	if (bufsize == -1) bufsize = 4096;
+	if (grbufsize == -1) grbufsize = 4096;
+
+	char buffer[bufsize];
+	switch (userid_type) {
+		case ID_TYPE_UUID:
+			if (userid_size != sizeof(uuid_t) || !parse_compatibility_uuid(userid, &id, &type) ||
+			    type != MBR_REC_TYPE_USER) {
+				return ENOENT;
+			}
+			getpwuid_r(id, &pwd, buffer, bufsize, &pwdp);
+			break;
+		case ID_TYPE_UID:
+			if (userid_size != sizeof(id_t)) return EINVAL;
+			getpwuid_r(*(const id_t *)userid, &pwd, buffer, bufsize, &pwdp);
+			break;
+		case ID_TYPE_USERNAME:
+			if (userid_size > MAXLOGNAME) return ENOENT;
+			memcpy(name, userid, userid_size);
+			name[userid_size] = '\0';
+			getpwnam_r(name, &pwd, buffer, bufsize, &pwdp);
+			break;
+		default:
+			return EINVAL;
+	}
+	if (pwdp == NULL) return ENOENT;
+	strlcpy(name, pwd.pw_name, sizeof(name));
+	pgid = pwd.pw_gid;
+
+	char grbuffer[grbufsize];
+	switch (groupid_type) {
+		case ID_TYPE_UUID:
+			if (!parse_compatibility_uuid(groupid, &id, &type) || type != MBR_REC_TYPE_GROUP) {
+				*isMember = 0;
+				return 0;
+			}
+			getgrgid_r(id, &grp, grbuffer, grbufsize, &grpp);
+			break;
+		case ID_TYPE_GID:
+			getgrgid_r(*(const id_t *)groupid, &grp, grbuffer, grbufsize, &grpp);
+			break;
+		case ID_TYPE_GROUPNAME:
+			getgrnam_r(groupid, &grp, grbuffer, grbufsize, &grpp);
+			break;
+		default:
+			return EINVAL;
+	}
+	*isMember = 0;
+	if (grpp == NULL) return 0;
+	if (grp.gr_gid == pgid) {
+		*isMember = 1;
+		return 0;
+	}
+	for (char **m = grp.gr_mem; m != NULL && *m != NULL; m++) {
+		if (strcmp(*m, name) == 0) {
+			*isMember = 1;
+			break;
+		}
+	}
+	return 0;
+}
+#endif
+
 LIBINFO_EXPORT
 int
 mbr_check_membership_ext(int userid_type, const void *userid, size_t userid_size, int groupid_type, const void *groupid, int refresh, int *isMember)
@@ -1001,6 +1089,8 @@ mbr_check_membership_ext(int userid_type, const void *userid, size_t userid_size
 
 #ifdef DS_AVAILABLE
 	result = _od_mbr_check_membership_ext(userid_type, userid, userid_size, groupid_type, groupid, refresh, isMember);
+#else
+	result = _files_mbr_check_membership_ext(userid_type, userid, userid_size, groupid_type, groupid, isMember);
 #endif
 
 	return result;
