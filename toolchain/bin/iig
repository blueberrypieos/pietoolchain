# iig: generate a DriverKit interface's header and implementation
# (toolchain/iig/iig.py).
TOOLCHAIN="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
exec "${PYTHON_FOR_BUILD:-python3}" -I "$TOOLCHAIN/iig/iig.py" "$@"
