# ld64 with its inputs' paths mapped for reproducible kernels
# (toolchain/hostcompat/ld-repro.py).
set -euo pipefail
TOOLCHAIN="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
exec "${PYTHON_FOR_BUILD:-python3}" -I "$TOOLCHAIN/hostcompat/ld-repro.py" "$@"
