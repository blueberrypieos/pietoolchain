Description: The i386 system call pages are not installed
 The SDK is for arm64. i386_get_ldt(2) and i386_set_ldt(2) document
 system calls it does not have.
Forwarded: not-needed

--- a/bsd/man/man2/Makefile
+++ b/bsd/man/man2/Makefile
@@ -1,3 +1,4 @@
+# Modified 2026-11-01: the i386 pages are not installed (APSL 2.0 section 2.2(b)).
 export MakeInc_cmd=${SRCROOT}/makedefs/MakeInc.cmd
 export MakeInc_def=${SRCROOT}/makedefs/MakeInc.def
 export MakeInc_rule=${SRCROOT}/makedefs/MakeInc.rule
@@ -114,8 +115,6 @@
 	gettimeofday.2		\
 	getuid.2		\
 	getxattr.2		\
-	i386_get_ldt.2		\
-	i386_set_ldt.2		\
 	intro.2			\
 	ioctl.2			\
 	issetugid.2		\
