Description: Add the work interval instance functions
 libdispatch's os_workgroup_interval calls work_interval_instance_*().
 This declares them in <sys/work_interval.h> and implements them in
 libsyscall's work_interval.c, finishing an interval with
 work_interval_notify().
Forwarded: not-needed

diff --git a/bsd/sys/work_interval.h b/bsd/sys/work_interval.h
--- a/bsd/sys/work_interval.h
+++ b/bsd/sys/work_interval.h
@@ -25,6 +25,7 @@
  *
  * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
  */
+/* Modified 2026-10-31: the work interval instance functions are added (APSL 2.0 section 2.2(b)). */
 
 #ifndef _SYS_WORK_INTERVAL_H
 #define _SYS_WORK_INTERVAL_H
@@ -285,6 +286,30 @@ int     work_interval_join_port(mach_port_t port);
  */
 int     work_interval_leave(void);
 
+struct work_interval_data {
+	uint32_t wid_version;
+	uint32_t wid_flags;
+	uint64_t wid_external_wakeups;
+	uint64_t wid_total_wakeups;
+	uint64_t wid_user_time_mach;
+	uint64_t wid_system_time_mach;
+	uint64_t wid_cycles;
+	uint64_t wid_instructions;
+};
+
+work_interval_instance_t work_interval_instance_alloc(work_interval_t interval_handle);
+void    work_interval_instance_free(work_interval_instance_t instance);
+void    work_interval_instance_clear(work_interval_instance_t instance);
+void    work_interval_instance_set_start(work_interval_instance_t instance, uint64_t start);
+void    work_interval_instance_set_deadline(work_interval_instance_t instance, uint64_t deadline);
+void    work_interval_instance_set_finish(work_interval_instance_t instance, uint64_t finish);
+void    work_interval_instance_set_complexity(work_interval_instance_t instance, uint64_t complexity);
+int     work_interval_instance_start(work_interval_instance_t instance);
+int     work_interval_instance_update(work_interval_instance_t instance);
+int     work_interval_instance_finish(work_interval_instance_t instance);
+void    work_interval_instance_get_telemetry_data(work_interval_instance_t instance,
+    work_interval_data_t data, size_t size);
+
 #endif /* !KERNEL */
 
 
diff --git a/libsyscall/wrappers/work_interval.c b/libsyscall/wrappers/work_interval.c
--- a/libsyscall/wrappers/work_interval.c
+++ b/libsyscall/wrappers/work_interval.c
@@ -20,6 +20,7 @@
  *
  * @APPLE_LICENSE_HEADER_END@
  */
+/* Modified 2026-10-31: the work interval instance functions are added (APSL 2.0 section 2.2(b)). */
 #include <sys/cdefs.h>
 #include <sys/types.h>
 #include <sys/work_interval.h>
@@ -272,3 +273,98 @@ work_interval_copy_port(work_interval_t interval_handle, mach_port_t *port)
 
 	return 0;
 }
+
+struct work_interval_instance {
+	work_interval_t wii_interval;
+	uint64_t wii_start;
+	uint64_t wii_deadline;
+	uint64_t wii_finish;
+	uint64_t wii_complexity;
+};
+
+work_interval_instance_t
+work_interval_instance_alloc(work_interval_t interval_handle)
+{
+	work_interval_instance_t instance = malloc(sizeof(*instance));
+	if (instance != NULL) {
+		bzero(instance, sizeof(*instance));
+		instance->wii_interval = interval_handle;
+	}
+	return instance;
+}
+
+void
+work_interval_instance_free(work_interval_instance_t instance)
+{
+	free(instance);
+}
+
+void
+work_interval_instance_clear(work_interval_instance_t instance)
+{
+	work_interval_t interval_handle = instance->wii_interval;
+	bzero(instance, sizeof(*instance));
+	instance->wii_interval = interval_handle;
+}
+
+void
+work_interval_instance_set_start(work_interval_instance_t instance, uint64_t start)
+{
+	instance->wii_start = start;
+}
+
+void
+work_interval_instance_set_deadline(work_interval_instance_t instance, uint64_t deadline)
+{
+	instance->wii_deadline = deadline;
+}
+
+void
+work_interval_instance_set_finish(work_interval_instance_t instance, uint64_t finish)
+{
+	instance->wii_finish = finish;
+}
+
+void
+work_interval_instance_set_complexity(work_interval_instance_t instance, uint64_t complexity)
+{
+	instance->wii_complexity = complexity;
+}
+
+int
+work_interval_instance_start(work_interval_instance_t instance)
+{
+	if (instance == NULL || instance->wii_interval == NULL) {
+		errno = EINVAL;
+		return -1;
+	}
+	return 0;
+}
+
+int
+work_interval_instance_update(work_interval_instance_t instance)
+{
+	return work_interval_instance_start(instance);
+}
+
+int
+work_interval_instance_finish(work_interval_instance_t instance)
+{
+	if (instance == NULL) {
+		errno = EINVAL;
+		return -1;
+	}
+	if (instance->wii_finish == 0) {
+		instance->wii_finish = mach_absolute_time();
+	}
+	return work_interval_notify(instance->wii_interval, instance->wii_start,
+	           instance->wii_finish, instance->wii_deadline, 0, 0);
+}
+
+void
+work_interval_instance_get_telemetry_data(work_interval_instance_t instance,
+    work_interval_data_t data, size_t size)
+{
+	(void)instance;
+	bzero(data, size);
+}
